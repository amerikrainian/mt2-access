#!/usr/bin/env bash
set -euo pipefail

mapfile -t STAGED_CS < <(
  git diff --cached --name-only --diff-filter=ACM -- '*.cs'
)

if [ "${#STAGED_CS[@]}" -eq 0 ]; then
  exit 0
fi

echo "Formatting staged C# files..."
# Per project: dotnet format cannot open the .slnx solution on every SDK.
for project in src/*/*.csproj; do
  dir="$(dirname "$project")/"
  files=()
  for file in "${STAGED_CS[@]}"; do
    case "$file" in "$dir"*) files+=("$file") ;; esac
  done
  if [ "${#files[@]}" -gt 0 ]; then
    dotnet format "$project" --include "${files[@]}" --no-restore
  fi
done

for file in "${STAGED_CS[@]}"; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done
