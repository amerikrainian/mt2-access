#!/usr/bin/env bash
set -euo pipefail

mapfile -t STAGED_CS < <(
  git diff --cached --name-only --diff-filter=ACM -- '*.cs'
)

if [ "${#STAGED_CS[@]}" -eq 0 ]; then
  exit 0
fi

echo "Formatting staged C# files..."
# One workspace of every project, through a throwaway classic .sln: dotnet format cannot open the .slnx
# on every SDK, and one project opened alone resolves its project references to nothing ("Warnings were
# encountered while loading the workspace": "Found project reference without a matching metadata
# reference"), so each project is formatted against references it never loaded.
SLN_DIR="$(mktemp -d)"
trap 'rm -rf "$SLN_DIR"' EXIT
dotnet new sln --format sln --name format --output "$SLN_DIR" > /dev/null
dotnet sln "$SLN_DIR/format.sln" add src/*/*.csproj > /dev/null
dotnet format "$SLN_DIR/format.sln" --include "${STAGED_CS[@]}" --no-restore

for file in "${STAGED_CS[@]}"; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done
